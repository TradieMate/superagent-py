# =============================================================================
# SUPERAGENT SDK DEMO CONFIGURATION
# =============================================================================

# Superagent API Configuration (for using Superagent Cloud)
SUPERAGENT_API_TOKEN=your_superagent_api_token_here
SUPERAGENT_BASE_URL=https://api.beta.superagent.sh

# Server Configuration
PORT=8000

# =============================================================================
# FULL SUPERAGENT API DEPLOYMENT (if running your own Superagent instance)
# =============================================================================

# MANDATORY VARIABLES for running Superagent API locally/deployed

# OpenAI API (required for most LLM operations)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (PostgreSQL/Supabase)
DATABASE_URL=postgres://user:password@host:port/postgres?pgbouncer=true
DATABASE_MIGRATION_URL=postgresql://user:password@host:port/postgres

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# Vector Database Configuration (choose one)
VECTORSTORE=qdrant  # Options: qdrant, pinecone, weaviate, astra_db, supabase

# Qdrant Configuration (if using Qdrant)
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_HOST=your_qdrant_host
QDRANT_INDEX=superagent

# Pinecone Configuration (if using Pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX=superagent

# Memory API (for conversation memory)
MEMORY_API_URL=https://memory.superagent.sh

# =============================================================================
# OPTIONAL LLM PROVIDER API KEYS
# =============================================================================

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=your_azure_endpoint

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_token

# Perplexity
PERPLEXITY_API_KEY=your_perplexity_api_key

# Together AI
TOGETHER_API_KEY=your_together_api_key

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region

# Groq
GROQ_API_KEY=your_groq_api_key

# Mistral
MISTRAL_API_KEY=your_mistral_api_key

# Cohere
COHERE_API_KEY=your_cohere_api_key

# =============================================================================
# OPTIONAL OBSERVABILITY & MONITORING
# =============================================================================

# AgentOps (agent monitoring)
AGENTOPS_API_KEY=your_agentops_api_key
AGENTOPS_ORG_KEY=your_agentops_org_key

# Langfuse (observability)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=your_langfuse_host

# LangSmith (observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT_ID=your_langsmith_project_id
LANGCHAIN_API_KEY=your_langchain_api_key

# =============================================================================
# OPTIONAL TOOLS & INTEGRATIONS
# =============================================================================

# E2B Code Interpreter
E2B_API_KEY=your_e2b_api_key

# Replicate (for running models)
REPLICATE_API_TOKEN=your_replicate_token

# Supabase (if using for storage/auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Drive/Dropbox/Box/OneDrive integration
NEXT_PUBLIC_APIDECK_API_KEY=your_apideck_key
NEXT_PUBLIC_APIDECK_API_ID=your_apideck_id